{
  "name": "job-roguelite",
  "private": true,
  "version": "0.4.0",
  "description": "J.O.B — a low-poly office roguelite battle arena (Risk of Rain x Left 4 Dead)",
  "license": "MIT",
  "author": "MaxJafar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxJafar/JOB.git"
  },
  "bugs": {
    "url": "https://github.com/MaxJafar/JOB/issues"
  },
  "homepage": "https://github.com/MaxJafar/JOB#readme",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "host": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,css}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"scripts/**/*.mjs\"",
    "check": "npm run lint && npm run test && npm run build",
    "model:check": "node scripts/check-model.mjs",
    "assets:inspect": "gltf-transform inspect",
    "electron": "electron electron/main.cjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@recast-navigation/three": "^0.43.1",
    "@three.ez/instanced-mesh": "^0.3.16",
    "bitecs": "^0.4.0",
    "comlink": "^4.4.2",
    "detect-gpu": "^5.0.70",
    "howler": "^2.2.4",
    "idb": "^8.0.3",
    "postprocessing": "^6.39.4",
    "recast-navigation": "^0.43.1",
    "seedrandom": "^3.0.5",
    "stats-gl": "^4.2.3",
    "three": "^0.180.0",
    "three-custom-shader-material": "^6.4.0",
    "three-mesh-bvh": "^0.9.14",
    "three.quarks": "^0.16.0",
    "troika-three-text": "^0.52.5",
    "tweakpane": "^4.0.5",
    "ws": "^8.18.0",
    "xstate": "^5.32.5",
    "yuka": "^0.7.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.2",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/howler": "^2.2.13",
    "@types/three": "^0.185.4",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
